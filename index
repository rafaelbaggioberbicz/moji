<style>
/* ==========================================================================
   ECOSSISTEMA MOJI — folha de estilos
   ========================================================================== */

:root {
  --ink:        #0b0b0c;
  --ink-soft:   #141412;
  --cream:      #f4efe4;
  --cream-2:    #efe8d8;
  --paper:      #f7f3ea;
  --gold:       #c9a35a;
  --gold-light: #e4c98a;
  --gold-deep:  #8a6a2f;
  --line:       rgba(244, 239, 228, 0.14);
  --line-dark:  rgba(11, 11, 12, 0.12);

  --font-display: 'Fraunces', Georgia, serif;
  --font-body: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;

  --maxw: 1180px;
  --pad: clamp(1.5rem, 5vw, 4rem);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  * { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
}

body {
  margin: 0;
  background: var(--ink);
  color: var(--paper);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
ul { margin: 0; padding: 0; list-style: none; }

.eyebrow {
  font-family: var(--font-body);
  font-size: 0.78rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--gold);
  font-weight: 600;
  margin: 0 0 1rem;
}
.eyebrow--dark { color: var(--gold-deep); }

.section-title {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(1.6rem, 3.4vw, 2.5rem);
  line-height: 1.25;
  color: var(--paper);
  max-width: 46rem;
  margin: 0 0 3rem;
}
.section-title--dark { color: var(--ink); }

/* ==========================================================================
   BOTÕES
   ========================================================================== */

.btn {
  display: inline-block;
  padding: 0.95rem 1.9rem;
  font-family: var(--font-body);
  font-size: 0.92rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  border-radius: 2px;
  border: 1px solid transparent;
  transition: transform 0.25s ease, background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  cursor: pointer;
}
.btn:hover { transform: translateY(-2px); }

.btn--gold {
  background: linear-gradient(180deg, var(--gold-light), var(--gold));
  color: var(--ink);
}
.btn--gold:hover { background: linear-gradient(180deg, var(--gold-light), var(--gold-light)); }

.btn--ghost {
  background: transparent;
  color: var(--paper);
  border-color: var(--line);
}
.btn--ghost:hover { border-color: var(--gold); color: var(--gold-light); }

.btn--line {
  background: transparent;
  color: var(--ink);
  border-color: var(--gold-deep);
}
.btn--line:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }

.btn--block { display: block; text-align: center; width: 100%; margin-top: 1.75rem; }
.btn--lg { padding: 1.1rem 2.6rem; font-size: 1rem; }

.text-link {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--gold-deep);
  border-bottom: 1px solid transparent;
  transition: border-color 0.25s ease;
}
.text-link:hover { border-color: var(--gold-deep); }

/* ==========================================================================
   NAV
   ========================================================================== */

.nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  padding: 1.1rem var(--pad);
  background: transparent;
  transition: background 0.35s ease, padding 0.35s ease, border-color 0.35s ease;
  border-bottom: 1px solid transparent;
}
.nav.is-scrolled {
  background: rgba(11, 11, 12, 0.86);
  backdrop-filter: blur(10px);
  padding-top: 0.85rem;
  padding-bottom: 0.85rem;
  border-color: var(--line);
}

.nav__inner {
  max-width: var(--maxw);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav__brand {
  font-family: var(--font-display);
  font-size: 1.05rem;
  letter-spacing: 0.03em;
  color: var(--paper);
}

.nav__links {
  display: flex;
  align-items: center;
  gap: 2.1rem;
  font-size: 0.86rem;
  letter-spacing: 0.02em;
}
.nav__links a { color: var(--paper); opacity: 0.82; transition: opacity 0.2s ease, color 0.2s ease; }
.nav__links a:hover { opacity: 1; color: var(--gold-light); }
.nav__cta {
  padding: 0.55rem 1.1rem;
  border: 1px solid var(--gold);
  border-radius: 2px;
  opacity: 1 !important;
  color: var(--gold-light) !important;
}
.nav__cta:hover { background: var(--gold); color: var(--ink) !important; }

.nav__toggle {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 32px; height: 32px;
  background: none; border: none; cursor: pointer;
  padding: 0;
}
.nav__toggle span {
  display: block; height: 1px; width: 100%;
  background: var(--paper);
  transition: transform 0.3s ease, opacity 0.3s ease;
}
.nav__toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
.nav__toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
.nav__toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

/* ==========================================================================
   HERO
   ========================================================================== */

.hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: 7.5rem var(--pad) 4rem;
}

.hero__rings {
  position: absolute;
  right: -12%;
  top: 50%;
  transform: translateY(-50%);
  width: 60vw;
  max-width: 780px;
  opacity: 0.5;
  pointer-events: none;
}
.hero__rings svg { width: 100%; height: 100%; }
.hero__rings circle {
  fill: none;
  stroke: var(--gold);
  stroke-width: 0.6;
  opacity: 0.55;
}

.hero__inner {
  position: relative;
  max-width: var(--maxw);
  margin: 0 auto;
  width: 100%;
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: clamp(2rem, 5vw, 4rem);
  align-items: center;
}

.hero__headline {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(2.3rem, 5.4vw, 3.6rem);
  line-height: 1.12;
  margin: 0 0 1.6rem;
  color: var(--paper);
}
.hero__headline em {
  font-style: italic;
  color: var(--gold-light);
}

.hero__sub {
  font-size: 1.05rem;
  color: rgba(244, 239, 228, 0.78);
  max-width: 32rem;
  margin: 0 0 2.4rem;
}

.hero__actions { display: flex; flex-wrap: wrap; gap: 1rem; }

/* ---- Foto do hero: mostra o rosto (object-position: top) ---- */
.hero__photo {
  position: relative;
  border-radius: 3px;
  overflow: hidden;
  aspect-ratio: 4 / 5;
  border: 1px solid var(--line);
}
.hero__photo::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(11,11,12,0) 55%, rgba(11,11,12,0.55));
  pointer-events: none;
}
.hero__photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center; /* garante que o rosto aparece */
}

.hero__scroll {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  width: 1px;
  height: 46px;
  background: var(--line);
}
.hero__scroll span {
  position: absolute;
  top: 0; left: -2px;
  width: 5px; height: 5px;
  border-radius: 50%;
  background: var(--gold);
  animation: scrollDot 2.2s ease-in-out infinite;
}
@keyframes scrollDot {
  0% { top: 0; opacity: 1; }
  85% { opacity: 1; }
  100% { top: 40px; opacity: 0; }
}

/* ==========================================================================
   SOBRE
   ========================================================================== */

.about {
  background: var(--cream);
  color: var(--ink);
  padding: clamp(4.5rem, 9vw, 8rem) var(--pad);
}
.about__inner {
  max-width: var(--maxw);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 0.75fr 1.25fr;
  gap: clamp(2.5rem, 6vw, 5rem);
  align-items: center;
}
.about__photo {
  aspect-ratio: 4 / 5;
  overflow: hidden;
  border-radius: 3px;
}
.about__photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
}

.about__lead {
  font-family: var(--font-display);
  font-size: clamp(1.3rem, 2.4vw, 1.7rem);
  line-height: 1.4;
  color: var(--ink);
  margin: 0 0 1.4rem;
}
.about__text p { color: rgba(11,11,12,0.75); margin: 0 0 1.2rem; }
.about__text .btn { margin-top: 0.8rem; }

/* ==========================================================================
   ECOSSISTEMA (visão geral)
   ========================================================================== */

.ecosystem {
  background: var(--ink);
  padding: clamp(4.5rem, 9vw, 8rem) var(--pad);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}
.ecosystem__inner { max-width: var(--maxw); margin: 0 auto; }

.ecosystem__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
  margin-top: 1rem;
}
.ecosystem__card {
  border: 1px solid var(--line);
  padding: 2.4rem;
  border-radius: 3px;
  transition: border-color 0.3s ease, transform 0.3s ease;
}
.ecosystem__card:hover { border-color: var(--gold); transform: translateY(-4px); }
.ecosystem__num {
  display: block;
  font-family: var(--font-display);
  font-size: 0.85rem;
  color: var(--gold);
  letter-spacing: 0.1em;
  margin-bottom: 1.2rem;
}
.ecosystem__card h3 {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: 1.35rem;
  margin: 0 0 0.7rem;
}
.ecosystem__card p {
  color: rgba(244,239,228,0.72);
  margin: 0 0 1.4rem;
}

/* ==========================================================================
   MENTORIAS
   ========================================================================== */

.mentorias {
  background: var(--ink-soft);
  padding: clamp(4.5rem, 9vw, 8rem) var(--pad);
}
.mentorias__inner { max-width: var(--maxw); margin: 0 auto; }

.mentorias__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.mcard {
  background: var(--ink);
  border: 1px solid var(--line);
  border-radius: 3px;
  padding: 2.4rem 2rem;
  display: flex;
  flex-direction: column;
  transition: border-color 0.3s ease, transform 0.3s ease;
}
.mcard:hover { border-color: var(--gold); transform: translateY(-6px); }

.mcard__icon {
  width: 52px; height: 52px;
  border: 1px solid var(--gold);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 1.4rem;
}
.mcard__icon svg { width: 24px; height: 24px; fill: none; stroke: var(--gold); stroke-width: 1.6; }

.mcard__kicker {
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(244,239,228,0.55);
  margin: 0 0 0.5rem;
}
.mcard h3 {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 500;
  color: var(--gold-light);
  margin: 0 0 0.9rem;
}
.mcard__desc {
  color: rgba(244,239,228,0.8);
  font-size: 0.95rem;
  margin: 0 0 1.4rem;
}
.mcard__list {
  border-top: 1px solid var(--line);
  padding-top: 1.2rem;
  flex-grow: 1;
}
.mcard__list li {
  position: relative;
  padding-left: 1.1rem;
  font-size: 0.88rem;
  color: rgba(244,239,228,0.72);
  margin-bottom: 0.7rem;
  line-height: 1.5;
}
.mcard__list li::before {
  content: "";
  position: absolute;
  left: 0; top: 0.55em;
  width: 5px; height: 5px;
  background: var(--gold);
  border-radius: 50%;
}

/* ==========================================================================
   SOLUÇÕES ESPECIALIZADAS
   ========================================================================== */

.solucoes {
  background: var(--cream);
  color: var(--ink);
  padding: clamp(4.5rem, 9vw, 8rem) var(--pad);
}
.solucoes__inner { max-width: var(--maxw); margin: 0 auto; }

.solucoes__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 1.25rem;
}

.scard {
  background: var(--cream-2);
  border: 1px solid var(--line-dark);
  border-radius: 3px;
  padding: 1.9rem 1.8rem;
  transition: border-color 0.3s ease, transform 0.3s ease, background 0.3s ease;
}
.scard:hover { border-color: var(--gold-deep); transform: translateY(-4px); background: var(--cream); }

.scard h3 {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 500;
  color: var(--gold-deep);
  margin: 0 0 1rem;
  padding-bottom: 0.8rem;
  border-bottom: 1px solid var(--line-dark);
}
.scard li {
  position: relative;
  padding-left: 1rem;
  font-size: 0.86rem;
  color: rgba(11,11,12,0.72);
  margin-bottom: 0.55rem;
  line-height: 1.45;
}
.scard li::before {
  content: "—";
  position: absolute;
  left: 0;
  color: var(--gold-deep);
}

.solucoes__cta { text-align: center; margin-top: 3.5rem; }

/* ==========================================================================
   DEPOIMENTOS
   ========================================================================== */

.depoimentos {
  background: var(--ink-soft);
  padding: clamp(4.5rem, 9vw, 8rem) var(--pad);
  border-top: 1px solid var(--line);
}
.depoimentos__inner { max-width: var(--maxw); margin: 0 auto; }

.depoimentos__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  align-items: start;
}

/* Card de depoimento em texto */
.dcard {
  background: var(--ink);
  border: 1px solid var(--line);
  border-radius: 3px;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
  transition: border-color 0.3s ease, transform 0.3s ease;
}
.dcard:hover { border-color: var(--gold); transform: translateY(-4px); }

.dcard__quote {
  font-family: var(--font-display);
  font-size: 2.5rem;
  line-height: 1;
  color: var(--gold);
  margin: 0;
}

.dcard__text {
  font-size: 0.95rem;
  color: rgba(244,239,228,0.82);
  line-height: 1.65;
  margin: 0;
  flex-grow: 1;
}

.dcard__img {
  width: 100%;
  border-radius: 2px;
  overflow: hidden;
}
.dcard__img img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 2px;
}

.dcard__author {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding-top: 1rem;
  border-top: 1px solid var(--line);
}
.dcard__author-info strong {
  display: block;
  font-size: 0.88rem;
  color: var(--gold-light);
  font-weight: 600;
}
.dcard__author-info span {
  font-size: 0.78rem;
  color: rgba(244,239,228,0.5);
}

/* Card de depoimento em vídeo */
.dcard--video { padding: 0; overflow: hidden; }
.dcard--video .dcard__video-wrap {
  position: relative;
  width: 100%;
  /* aspect-ratio 9:16 para vídeos verticais (stories/reels) */
  aspect-ratio: 9 / 16;
  background: #000;
  cursor: pointer;
}
.dcard--video .dcard__video-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  transition: opacity 0.3s ease;
}
.dcard--video .dcard__video-wrap video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: none;
}
.dcard--video .dcard__video-wrap.is-playing img { opacity: 0; }
.dcard--video .dcard__video-wrap.is-playing video { display: block; }

.dcard__play {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 56px; height: 56px;
  border-radius: 50%;
  background: rgba(11,11,12,0.65);
  border: 2px solid var(--gold);
  display: flex; align-items: center; justify-content: center;
  transition: transform 0.25s ease, background 0.25s ease;
  pointer-events: none;
}
.dcard--video .dcard__video-wrap:hover .dcard__play {
  transform: translate(-50%, -50%) scale(1.1);
  background: rgba(201,163,90,0.25);
}
.dcard__play svg { width: 20px; height: 20px; fill: var(--gold-light); margin-left: 3px; }

.dcard--video .dcard__video-wrap.is-playing .dcard__play { display: none; }

.dcard--video .dcard__caption {
  padding: 1.2rem 1.5rem;
  font-size: 0.84rem;
  color: rgba(244,239,228,0.6);
  font-style: italic;
  border-top: 1px solid var(--line);
}

/* ==========================================================================
   CTA FINAL
   ========================================================================== */

.final {
  position: relative;
  background: var(--ink);
  overflow: hidden;
  padding: clamp(5.5rem, 12vw, 10rem) var(--pad);
  text-align: center;
}
.final__rings {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 90vw;
  max-width: 900px;
  opacity: 0.35;
  pointer-events: none;
}
.final__rings circle { fill: none; stroke: var(--gold); stroke-width: 0.5; }

.final__inner { position: relative; max-width: 42rem; margin: 0 auto; }
.final .eyebrow { justify-content: center; }
.final__headline {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(1.9rem, 4.4vw, 3rem);
  line-height: 1.25;
  margin: 0 0 1.4rem;
}
.final__sub {
  color: rgba(244,239,228,0.75);
  font-size: 1.05rem;
  margin: 0 0 2.4rem;
}

/* ==========================================================================
   FOOTER
   ========================================================================== */

.footer {
  background: var(--ink);
  border-top: 1px solid var(--line);
  padding: 1.8rem var(--pad) 2.2rem;
}
.footer__inner {
  max-width: var(--maxw);
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 0.5rem;
  font-size: 0.8rem;
  color: rgba(244,239,228,0.5);
}

/* ==========================================================================
   SCROLL REVEAL
   ========================================================================== */

[data-reveal] {
  opacity: 0;
  transform: translateY(22px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}
[data-reveal].is-visible {
  opacity: 1;
  transform: translateY(0);
}

/* ==========================================================================
   RESPONSIVE
   ========================================================================== */

@media (max-width: 900px) {
  .hero__inner { grid-template-columns: 1fr; }
  /* No mobile, a foto vem ANTES do texto no DOM mas mostramos depois via order */
  .hero__photo {
    order: -1;           /* foto acima do texto no mobile */
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    aspect-ratio: 3 / 4; /* proporção um pouco mais aberta no mobile */
  }
  .hero__rings { opacity: 0.25; }

  .about__inner { grid-template-columns: 1fr; }
  .about__photo { max-width: 340px; margin: 0 auto; }

  .ecosystem__grid { grid-template-columns: 1fr; }
  .mentorias__grid { grid-template-columns: 1fr; max-width: 460px; margin: 0 auto; }

  /* Depoimentos: 2 colunas no tablet, 1 no mobile */
  .depoimentos__grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 720px) {
  .nav__links {
    position: fixed;
    top: 0; right: 0;
    height: 100svh;
    width: min(78vw, 320px);
    background: var(--ink);
    border-left: 1px solid var(--line);
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 2rem;
    padding: 2rem 2.4rem;
    transform: translateX(100%);
    transition: transform 0.4s ease;
  }
  .nav__links.is-open { transform: translateX(0); }
  .nav__links a { font-size: 1.05rem; }
  .nav__toggle { display: flex; }

  .hero { padding-top: 6.5rem; text-align: left; }
